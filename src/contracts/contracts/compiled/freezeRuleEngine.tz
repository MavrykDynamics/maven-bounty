{ parameter (or (address %freeze_account) (address %unfreeze_account)) ;
  storage (pair (address %administrator) (big_map %frozen_accounts address unit)) ;
  code { UNIT ;
         NIL operation ;
         LAMBDA
           (pair unit (pair address (big_map address unit)))
           unit
           { UNPAIR ;
             SWAP ;
             CAR ;
             SENDER ;
             COMPARE ;
             EQ ;
             IF {} { PUSH nat 1 ; FAILWITH } } ;
         DUP 3 ;
         APPLY ;
         DIG 3 ;
         UNPAIR ;
         IF_LEFT
           { SWAP ;
             DUP ;
             DIG 3 ;
             SWAP ;
             EXEC ;
             DROP ;
             DUP ;
             CDR ;
             DIG 4 ;
             DIG 3 ;
             SWAP ;
             SOME ;
             SWAP ;
             UPDATE ;
             SWAP ;
             CAR }
           { DIG 4 ;
             DROP ;
             SWAP ;
             DUP ;
             DIG 3 ;
             SWAP ;
             EXEC ;
             DROP ;
             DUP ;
             CDR ;
             DIG 2 ;
             NONE unit ;
             SWAP ;
             UPDATE ;
             SWAP ;
             CAR } ;
         PAIR ;
         SWAP ;
         PAIR } ;
  view "view_is_transfer_valid"
       (pair (pair (nat %amount) (address %from_)) (address %to_) (nat %token_id))
       (option bool)
       { UNPAIR ;
         PUSH bool True ;
         DUP 3 ;
         CDR ;
         DUP 3 ;
         CDR ;
         CAR ;
         GET ;
         IF_NONE { PUSH bool False } { DROP ; PUSH bool True } ;
         COMPARE ;
         EQ ;
         PUSH bool True ;
         DIG 3 ;
         CDR ;
         DIG 3 ;
         CAR ;
         CDR ;
         GET ;
         IF_NONE { PUSH bool False } { DROP ; PUSH bool True } ;
         COMPARE ;
         EQ ;
         OR ;
         IF { PUSH bool False } { PUSH bool True } ;
         SOME } }

